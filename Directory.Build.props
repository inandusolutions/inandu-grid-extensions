<Project>

  <!-- Shared settings for every project in the repo. Project-specific overrides live in each .csproj. -->
  <PropertyGroup>
    <!-- Pinned so the library compiles identically on the .NET 8 and .NET 10 SDKs. -->
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- NuGet package metadata. Only src/Inandu.Grid.Extensions sets IsPackable=true. -->
  <PropertyGroup>
    <Product>Inandu.Grid.Extensions</Product>
    <Company>Inandu SAS</Company>
    <Authors>Inandu SAS</Authors>
    <Copyright>Copyright © Inandu SAS</Copyright>
    <PackageProjectUrl>https://github.com/inandusolutions/inandu-grid</PackageProjectUrl>
    <RepositoryUrl>https://github.com/inandusolutions/inandu-grid-extensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>inandu-grid;angular;data-grid;server-side;paging;sorting;filtering;linq;aspnetcore</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

</Project>
