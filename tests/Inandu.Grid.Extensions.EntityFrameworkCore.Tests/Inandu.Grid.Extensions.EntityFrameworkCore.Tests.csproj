<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Inandu.Grid.Extensions.EntityFrameworkCore.Tests</RootNamespace>
    <AssemblyName>Inandu.Grid.Extensions.EntityFrameworkCore.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- SQLite's native bundle (test-only, never shipped) trips NuGet audit. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.22" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- Real servers, only used when INANDU_TEST_PROVIDER is sqlserver / postgres (CI runs both). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.22" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- Transitive via Microsoft.Data.SqlClient; the 9.0.11 it resolves to has advisories GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7. Test-only. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Inandu.Grid.Extensions.EntityFrameworkCore/Inandu.Grid.Extensions.EntityFrameworkCore.csproj" />
  </ItemGroup>

</Project>
