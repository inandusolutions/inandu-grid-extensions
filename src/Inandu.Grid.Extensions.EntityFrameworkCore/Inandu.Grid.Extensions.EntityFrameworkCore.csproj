<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">net8.0;net10.0</TargetFrameworks>

    <RootNamespace>Inandu.Grid.Extensions.EntityFrameworkCore</RootNamespace>
    <AssemblyName>Inandu.Grid.Extensions.EntityFrameworkCore</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackageId>Inandu.Grid.Extensions.EntityFrameworkCore</PackageId>
    <Title>Inandu.Grid.Extensions.EntityFrameworkCore</Title>
    <Version>0.7.0</Version>
    <!-- Fail the pack on a breaking public-API change against the last released version. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.6.0</PackageValidationBaselineVersion>
    <Description>Async EF Core companion for Inandu.Grid.Extensions — ToInanduGridAsync() runs the inandu-grid serverSide request as SQL with CountAsync + ToListAsync. Targets .NET 8 and .NET 10.</Description>
    <PackageReleaseNotes>See the CHANGELOG at the repository root.</PackageReleaseNotes>
    <PackageTags>inandu-grid;angular;react;vue;data-grid;server-side;paging;efcore;entity-framework;async</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- This is the MINIMUM EF Core a consumer must have, not the version we test against: NuGet
         resolves the consumer's own (newer) EF Core. Keep it low so a .NET 8 app on EF Core 8 isn't
         forced onto EF Core 9. 8.0.11 clears the transitive Microsoft.Extensions.Caching.Memory
         advisory (GHSA-qj66-m88j-hmgj). Raise it only for an advisory or a new API we need —
         Dependabot is told to leave this package alone (.github/dependabot.yml). The test
         projects run against the latest EF Core. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Inandu.Grid.Extensions/Inandu.Grid.Extensions.csproj" />
  </ItemGroup>

</Project>
